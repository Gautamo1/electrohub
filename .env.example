# ---- Server ----
# Port the Express API listens on (Render injects PORT automatically)
PORT=5000

# production | development
NODE_ENV=development

# ---- Database ----
# Local PostgreSQL example:
DATABASE_URL=postgresql://postgres:***@localhost:5432/electrohub
# Render PostgreSQL example (managed via render.yaml, do not hardcode):
# DATABASE_URL=postgresql://user:***@host.render.com:5432/dbname

# Set to "true" to prevent automatic schema creation + seeding on boot
# SKIP_DB_INIT=false